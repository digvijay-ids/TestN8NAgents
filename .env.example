# Copy to .env and fill in real values. Vite only exposes VITE_* vars.

# DocProcessing API — now proxied through the patmimo-utilities backend and
# authenticated with the user's bearer token. Optional; defaults to
# ${VITE_BACKEND_URL}/api/DocProcessing. Basic-auth creds live server-side only.
# VITE_API_BASE_URL=

# Attorney search API
VITE_ATTORNEY_SEARCH_URL=https://docfilling-api.noetherip.com/api/attorneys/search
VITE_USE_MOCK_ATTORNEY_API=false

# Claims webhook (fire-and-forget)
VITE_CLAIMS_WEBHOOK_URL=https://docfilling-api.noetherip.com/api/claims?
VITE_N8N_WEBHOOK_URL=https://n8n.noetherip.com/webhook/v1/wipo-claims?model=LocalLLM

# USPTO application data API (continuity, etc.)
VITE_USPTO_API_BASE_URL=http://localhost:8000/api/uspto

# Timeouts (ms)
VITE_REQUEST_TIMEOUT=60000
VITE_ATTORNEY_REQUEST_TIMEOUT=15000

# patmimo-utilities backend base URL (auth + access management + APIs).
# The frontend talks only to this backend; no Supabase keys live in the frontend.
VITE_BACKEND_URL=http://localhost:8000
